<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quiver.Studio.ViewModels"
             xmlns:views="using:Quiver.Studio.Views"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="Quiver.Studio.Views.WorkspaceView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="*,4,*">
        <!-- Query Editor -->
        <DockPanel Grid.Row="0">
            <!-- Toolbar: mode tabs + execute -->
            <Border DockPanel.Dock="Top"
                    Padding="8,4"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TabStrip SelectedIndex="{Binding QueryModeIndex}"
                              FontSize="12">
                        <TabStripItem Content="Traversal" />
                        <TabStripItem Content="FullText" />
                    </TabStrip>
                    <Button Content="▶ Execute (F5)"
                            Click="OnExecuteClick"
                            IsEnabled="{Binding IsConnected}"
                            Padding="12,4" />
                </StackPanel>
            </Border>

            <!-- Traversal: C# code editor -->
            <ae:TextEditor x:Name="QueryTextEditor"
                           FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                           FontSize="13"
                           ShowLineNumbers="True"
                           IsVisible="{Binding IsTraversalMode}" />

            <!-- FullText: FTS parameter panel -->
            <views:FullTextSearchPanel DataContext="{Binding FullTextSearch}"
                                       IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsFullTextMode}" />
        </DockPanel>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1"
                      ResizeDirection="Rows"
                      Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />

        <!-- Results / Output -->
        <Border Grid.Row="2">
            <TabControl>
                <!-- Results tab (DataGrid) -->
                <TabItem Header="Results">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Padding="8,4"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="0,0,0,1"
                                IsVisible="{Binding Results.HasRows}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Copy CSV"
                                        Command="{Binding Results.CopyCsvCommand}"
                                        Padding="8,2"
                                        FontSize="11" />
                                <Button Content="Copy JSON"
                                        Command="{Binding Results.CopyJsonCommand}"
                                        Padding="8,2"
                                        FontSize="11" />
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="ResultsGrid"
                                  ItemsSource="{Binding Results.Rows}"
                                  SelectedItem="{Binding Results.SelectedItem}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="All"
                                  FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                  FontSize="12"
                                  IsVisible="{Binding Results.HasRows}" />

                        <TextBlock Text="Execute a query to see results"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   FontSize="12"
                                   IsVisible="{Binding !Results.HasRows}" />
                    </DockPanel>
                </TabItem>

                <!-- Graph tab -->
                <TabItem Header="Graph">
                    <views:GraphCanvas DataContext="{Binding GraphCanvas}" />
                </TabItem>

                <!-- Output tab (text) -->
                <TabItem Header="Output">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding QueryEditor.Output}"
                                   FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                   FontSize="12"
                                   Padding="8"
                                   TextWrapping="NoWrap" />
                    </ScrollViewer>
                </TabItem>

                <!-- History tab -->
                <TabItem Header="History">
                    <views:QueryHistoryPanel DataContext="{Binding QueryHistory}" />
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
