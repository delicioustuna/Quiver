<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quiver.Studio.ViewModels"
             xmlns:views="using:Quiver.Studio.Views"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:i="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             x:Class="Quiver.Studio.Views.WorkspaceView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="*,4,*">
        <!-- Query Editor -->
        <DockPanel Grid.Row="0">
            <!-- Toolbar: mode tabs + execute -->
            <Border DockPanel.Dock="Top"
                    Padding="8,4"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TabStrip SelectedIndex="{Binding QueryModeIndex}"
                              FontSize="12">
                        <TabStripItem>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:SymbolIcon Symbol="Code" 
                                      FontSize="16" 
                                      VerticalAlignment="Center" />
                                <TextBlock Text="クエリ" 
                                      VerticalAlignment="Center" />
                            </StackPanel>
                        </TabStripItem>
                        <TabStripItem>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:SymbolIcon Symbol="SearchSquare" 
                                      FontSize="16" 
                                      VerticalAlignment="Center" />
                                <TextBlock Text="全文検索" 
                                      VerticalAlignment="Center" />
                            </StackPanel>
                        </TabStripItem>
                    </TabStrip>

                    <Button Click="OnExecuteClick"
                            IsEnabled="{Binding IsConnected}"
                            Padding="12,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:SymbolIcon Symbol="Play" 
                                  FontSize="16" 
                                  VerticalAlignment="Center" />
                            <TextBlock Text="実行 (F5)" 
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Traversal: C# code editor -->
            <ae:TextEditor x:Name="QueryTextEditor"
                           FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                           FontSize="13"
                           ShowLineNumbers="True"
                           IsVisible="{Binding IsTraversalMode}" />

            <!-- FullText: FTS parameter panel -->
            <views:FullTextSearchPanel DataContext="{Binding FullTextSearch}"
                                       IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsFullTextMode}" />
        </DockPanel>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1"
                      ResizeDirection="Rows"
                      Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />

        <!-- Results / Output -->
        <Border Grid.Row="2">
            <TabControl>
                <!-- Results tab (DataGrid) -->
                <TabItem Header="結果">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Padding="8,4"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="0,0,0,1"
                                IsVisible="{Binding Results.HasRows}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding Results.CopyCsvCommand}"
                                        Padding="8,2"
                                        FontSize="11">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <i:SymbolIcon Symbol="DocumentCsv" 
                                              FontSize="16" 
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="コピー" 
                                              VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding Results.CopyJsonCommand}"
                                        Padding="8,2"
                                        FontSize="11" >
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <i:SymbolIcon Symbol="Braces" 
                                              FontSize="16" 
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="コピー" 
                                              VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="ResultsGrid"
                                  ItemsSource="{Binding Results.Rows}"
                                  SelectedItem="{Binding Results.SelectedItem}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="All"
                                  FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                  FontSize="12"
                                  IsVisible="{Binding Results.HasRows}" />

                        <TextBlock Text="Execute a query to see results"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   FontSize="12"
                                   IsVisible="{Binding !Results.HasRows}" />
                    </DockPanel>
                </TabItem>

                <!-- Graph tab -->
                <TabItem Header="グラフ">
                    <views:GraphCanvas DataContext="{Binding GraphCanvas}" />
                </TabItem>

                <!-- Output tab (text) -->
                <TabItem Header="出力">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding QueryEditor.Output}"
                                   FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                   FontSize="12"
                                   Padding="8"
                                   TextWrapping="NoWrap" />
                    </ScrollViewer>
                </TabItem>

                <!-- History tab -->
                <TabItem Header="履歴">
                    <views:QueryHistoryPanel DataContext="{Binding QueryHistory}" />
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
