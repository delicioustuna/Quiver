<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quiver.Studio.ViewModels"
             xmlns:views="using:Quiver.Studio.Views"
             xmlns:i="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             x:Class="Quiver.Studio.Views.GraphCanvas"
             x:DataType="vm:GraphCanvasViewModel">
    <Panel>
        <views:GraphCanvasPanel x:Name="CanvasPanel" />

        <!-- Layout toggle -->
        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,8,0"
                    IsHitTestVisible="True"
                    IsVisible="{Binding HasGraph}">
            <ToggleButton IsChecked="{Binding !IsHierarchicalLayout}"
                          FontSize="11" Padding="8,2">
                <i:SymbolIcon Symbol="IoT"
                              FontSize="16" 
                              VerticalAlignment="Center"
                              ToolTip.Tip="分散レイアウト" />
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsHierarchicalLayout}"
                          FontSize="11" Padding="8,2">
                <i:SymbolIcon Symbol="Org"
                              FontSize="16" 
                              VerticalAlignment="Center" 
                              ToolTip.Tip="階層レイアウト" />
            </ToggleButton>
        </StackPanel>

        <TextBlock Text="クエリを実行してノードを返すとグラフが表示されます"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   FontSize="12"
                   IsHitTestVisible="False"
                   IsVisible="{Binding !HasGraph}" />
    </Panel>
</UserControl>
