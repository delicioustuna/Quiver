<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quiver.Studio.ViewModels"
             xmlns:m="using:Quiver.Studio.Models"
             x:Class="Quiver.Studio.Views.QueryHistoryPanel"
             x:DataType="vm:QueryHistoryViewModel">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Padding="8,4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding FilterText}"
                         PlaceholderText="Filter history..."
                         FontSize="12" />
                <Button Grid.Column="1"
                        Content="Clear All"
                        Command="{Binding ClearHistoryCommand}"
                        Padding="8,2"
                        FontSize="11"
                        Margin="4,0,0,0" />
            </Grid>
        </Border>

        <!-- History list -->
        <ListBox ItemsSource="{Binding FilteredEntries}"
                 DoubleTapped="OnEntryDoubleTapped"
                 FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                 FontSize="12">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="m:QueryHistoryEntry">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding Code}"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding DurationMs, StringFormat='{}{0:F0}ms'}" />
                                <TextBlock FontSize="10"
                                           Foreground="OrangeRed"
                                           Text="ERROR"
                                           IsVisible="{Binding WasError}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding $parent[ListBox].((vm:QueryHistoryViewModel)DataContext).DeleteEntryCommand}"
                                CommandParameter="{Binding}"
                                FontSize="10"
                                Padding="4,1"
                                VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
