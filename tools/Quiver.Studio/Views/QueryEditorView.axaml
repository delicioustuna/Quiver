<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quiver.Studio.ViewModels"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:res="using:Quiver.Studio.Resources"
             x:Class="Quiver.Studio.Views.QueryEditorView"
             x:DataType="vm:QueryEditorViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="8,4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnExecuteClick"
                        IsEnabled="{Binding !IsExecuting}"
                        Padding="12,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource PlayIcon}"
                                 Width="16" Height="16"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:Strings.ExecuteF5}"
                              VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <ae:TextEditor x:Name="QueryTextEditor"
                       FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                       FontSize="13"
                       ShowLineNumbers="True" />
    </DockPanel>
</UserControl>
