<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Quiver.Studio.Views.AddRelationshipDialog"
        Title="Add Relationship"
        Width="360" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Relationship Type (select existing or type new):" FontWeight="SemiBold" />
        <AutoCompleteBox x:Name="TypeBox"
                         FilterMode="Contains"
                         FontSize="13" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    Click="OnCancel"
                    Padding="16,6"
                    IsCancel="True" />
            <Button Content="Create"
                    Click="OnCreate"
                    Padding="16,6"
                    IsDefault="True"
                    Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
