        <StreamGeometry x:Key="ArrowDownloadIcon">M15.5 17C15.776 17 16 17.224 16 17.5C16 17.745 15.823 17.949 15.59 17.992L15.5 18H4.5C4.224 18 4 17.776 4 17.5C4 17.254 4.177 17.05 4.41 17.008L4.5 17ZM10 2.002C10.246 2.002 10.45 2.179 10.492 2.412L10.5 2.502 10.496 14.296 14.141 10.648C14.315 10.474 14.584 10.454 14.779 10.589L14.849 10.647C15.022 10.82 15.042 11.09 14.907 11.285L14.849 11.354 10.357 15.854C10.285 15.927 10.196 15.972 10.102 15.991L9.996 16.001C9.835 16.001 9.692 15.925 9.601 15.807L5.144 11.355C4.948 11.16 4.948 10.843 5.143 10.648C5.317 10.474 5.586 10.454 5.781 10.589L5.85 10.647 9.496 14.288 9.5 2.502C9.5 2.226 9.724 2.002 10 2.002Z</StreamGeometry>
        <StreamGeometry x:Key="ImageIcon">M14 7.5C14 8.328 13.328 9 12.5 9C11.672 9 11 8.328 11 7.5C11 6.672 11.672 6 12.5 6C13.328 6 14 6.672 14 7.5ZM13 7.5C13 7.224 12.776 7 12.5 7C12.224 7 12 7.224 12 7.5C12 7.776 12.224 8 12.5 8C12.776 8 13 7.776 13 7.5ZM3 6C3 4.343 4.343 3 6 3H14C15.657 3 17 4.343 17 6V14C17 15.657 15.657 17 14 17H6C4.343 17 3 15.657 3 14ZM6 4C4.895 4 4 4.895 4 6V14C4 14.373 4.102 14.722 4.279 15.02L8.949 10.432C9.532 9.859 10.468 9.859 11.051 10.432L15.721 15.02C15.898 14.722 16 14.373 16 14V6C16 4.895 15.105 4 14 4ZM6 16H14C14.369 16 14.715 15.9 15.012 15.726L10.35 11.145C10.156 10.954 9.844 10.954 9.65 11.145L4.988 15.726C5.285 15.9 5.631 16 6 16Z</StreamGeometry>
        <StreamGeometry x:Key="EraserIcon">M11.197 2.439C11.783 1.854 12.733 1.854 13.318 2.439L17.561 6.682C18.147 7.268 18.147 8.218 17.561 8.803L9.364 17H14.5C14.776 17 15 17.224 15 17.5C15 17.776 14.776 18 14.5 18H7.82C7.41 18.022 6.993 17.876 6.68 17.563L2.437 13.32C1.852 12.735 1.852 11.785 2.437 11.199ZM12.611 3.146C12.416 2.951 12.099 2.951 11.904 3.146L5.538 9.512 10.488 14.462 16.854 8.096C17.049 7.901 17.049 7.584 16.854 7.389ZM9.781 15.169 4.831 10.219 3.144 11.906C2.949 12.101 2.949 12.418 3.144 12.613L7.387 16.856C7.582 17.051 7.899 17.051 8.094 16.856Z</StreamGeometry>
    </Application.Resources>

    <Application.DataTemplates>

        <!--
            Dock.Avalonia renders dockable content via DeferredContentControl Content="{Binding}",
            which sets the dockable object itself (Document/Tool) as content. Since Dock.Model.Inpc's
            Document/Tool don't implement IDocumentContent/IToolContent, the theme's built-in templates
            won't match — so we bridge: match the INPC type, then delegate to Context where the actual
            view-model wrapper lives. The per-context DataTemplates below take over from there.
            These must be at Application level (not Window) so floating/detached windows can resolve them.
        -->
        <DataTemplate DataType="{x:Type dockInpc:Document}">
            <ContentControl Content="{Binding Context}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockInpc:Tool}">
            <ContentControl Content="{Binding Context}" />
        </DataTemplate>

        <!-- Schema Browser -->
        <DataTemplate DataType="{x:Type dock:SchemaToolModel}">
            <DockPanel>
                <TreeView ItemsSource="{Binding ViewModel.RootNodes}"
                          Margin="4,0"
                          IsVisible="{Binding !!ViewModel.RootNodes.Count}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Icon}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Width="16"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <TextBlock Text="{x:Static res:Strings.OpenDatabasePrompt}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="12,20"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           IsVisible="{Binding !ViewModel.RootNodes.Count}" />
            </DockPanel>
        </DataTemplate>

        <!-- Statistics -->
        <DataTemplate DataType="{x:Type dock:StatsToolModel}">
            <ScrollViewer Padding="8">
                <StackPanel Spacing="8">
                    <StackPanel Spacing="6"
                                IsVisible="{Binding ViewModel.IsConnected}">
                        <TextBlock Text="{Binding ViewModel.FilePath}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ViewModel.FilePath}"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                        <Border Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                                CornerRadius="4"
                                Padding="8,6"
                                IsVisible="{Binding ViewModel.Statistics, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Stats_Vertices}" FontSize="11" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11"
                                           Text="{Binding ViewModel.Statistics.VertexCount, StringFormat='{}{0:N0}'}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.Stats_Edges}" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11"
                                           Text="{Binding ViewModel.Statistics.EdgeCount, StringFormat='{}{0:N0}'}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.Stats_Properties}" FontSize="11" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11"
                                           Text="{Binding ViewModel.Statistics.PropertyCount, StringFormat='{}{0:N0}'}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.Stats_DataFile}" FontSize="11" />
                                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11"
                                           Text="{Binding ViewModel.Statistics.DataFileSize, Converter={StaticResource FileSizeConverter}}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:Strings.Stats_WAL}" FontSize="11" />
                                <TextBlock Grid.Row="4" Grid.Column="1" FontSize="11"
                                           Text="{Binding ViewModel.Statistics.WalFileSize, Converter={StaticResource FileSizeConverter}}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{x:Static res:Strings.Disconnected}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               IsVisible="{Binding !ViewModel.IsConnected}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Query Editor -->
        <DataTemplate DataType="{x:Type dock:QueryEditorDocModel}">
            <views:QueryEditorView DataContext="{Binding ViewModel}" />
        </DataTemplate>

        <!-- Full-text Search -->
        <DataTemplate DataType="{x:Type dock:FtsDocModel}">
            <views:FullTextSearchPanel DataContext="{Binding ViewModel}" />
        </DataTemplate>

        <!-- Settings -->
        <DataTemplate DataType="{x:Type dock:SettingsDocModel}">
            <views:SettingsPage DataContext="{Binding ViewModel}" />
        </DataTemplate>

        <!-- Results DataGrid -->
        <DataTemplate DataType="{x:Type dock:ResultsToolModel}">
            <views:ResultsView DataContext="{Binding ViewModel}" />
        </DataTemplate>

        <!-- Graph Canvas -->
        <DataTemplate DataType="{x:Type dock:GraphToolModel}">
            <views:GraphCanvas DataContext="{Binding ViewModel}" />
        </DataTemplate>

        <!-- Output Log -->
        <DataTemplate DataType="{x:Type dock:OutputToolModel}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ViewModel.Output}"
                           FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                           FontSize="12"
                           Padding="8"
                           TextWrapping="NoWrap" />
            </ScrollViewer>
        </DataTemplate>

        <!-- Query History -->
        <DataTemplate DataType="{x:Type dock:HistoryToolModel}">
            <views:QueryHistoryPanel DataContext="{Binding ViewModel}" />
        </DataTemplate>

        <!-- Property Inspector -->
        <DataTemplate DataType="{x:Type dock:PropertiesToolModel}">
            <views:PropertyInspector DataContext="{Binding ViewModel}" />
        </DataTemplate>

        <!-- API Documentation -->
        <DataTemplate DataType="{x:Type dock:ApiDocToolModel}">
            <views:ApiDocumentationPanel DataContext="{Binding ViewModel}" />
        </DataTemplate>

    </Application.DataTemplates>
</Application>
