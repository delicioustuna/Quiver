<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:Dock.Avalonia.Themes.Fluent"
             xmlns:conv="using:Quiver.Studio.Converters"
             xmlns:dock="using:Quiver.Studio.Docking"
             xmlns:dockInpc="using:Dock.Model.Inpc.Controls"
             xmlns:views="using:Quiver.Studio.Views"
             xmlns:res="using:Quiver.Studio.Resources"
             x:Class="Quiver.Studio.App">
    <Application.Styles>
        <FluentTheme />
        <themes:DockFluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Window chrome button hover -->
        <Style Selector="Button#MinimizeButton:pointerover /template/ ContentPresenter,
                          Button#MaximizeButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Button#CloseButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E81123" />
        </Style>
        <Style Selector="Button#CloseButton:pointerover PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter" />

        <!-- Fluent UI System Icons (MIT) — 20×20 viewBox -->
