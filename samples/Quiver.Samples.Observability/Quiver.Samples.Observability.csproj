<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Quiver.Samples.Observability</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Quiver\Quiver.csproj" />
    <ProjectReference Include="..\..\src\Quiver.Core\Quiver.Core.csproj" />
    <ProjectReference Include="..\..\src\Quiver.OpenTelemetry\Quiver.OpenTelemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Console exporter は ootb で動く軽量ターゲット。Jaeger/Prometheus へは OTLP / Prometheus exporter を差し替えれば良い。 -->
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
  </ItemGroup>
</Project>
