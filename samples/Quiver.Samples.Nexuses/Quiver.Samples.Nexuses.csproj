<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);QUIVER_LEGACY_GENERATED_API</DefineConstants>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Quiver.Samples.Nexuses</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Quiver.Rag\Quiver.Rag.csproj" />
    <!-- 属性は Quiver 本体に含まれる。生成器 (analyzer) のみ直接参照する。 -->
    <ProjectReference Include="..\..\src\Quiver.SourceGen\Quiver.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
