{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Quiver": {
    "DataDirectory": "./quiver-data",
    "BufferPoolSize": 268435456,
    "CheckpointThresholdBytes": 67108864,
    "CheckpointPolicy": "Fixed",
    "WriterWaitTimeout": "00:00:05",
    "WriterContentionMode": "Wait",
    "EnableChecksums": true,
    "Backend": "Binary"
  }
}
