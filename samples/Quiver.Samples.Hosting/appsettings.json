{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Quiver": {
    "DataDirectory": "./quiver-data",
    "BufferPoolSize": 268435456,
    "WalSegmentSize": 67108864,
    "CheckpointThresholdBytes": 67108864,
    "CheckpointPolicy": "Fixed",
    "LockTimeout": "00:00:05",
    "LockingMode": "ExclusiveOnly",
    "EnableChecksums": true,
    "Backend": "Binary",
    "GroupCommitWindow": "00:00:00"
  }
}
