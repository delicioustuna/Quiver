    <LangVersion>latest</LangVersion>
    <RootNamespace>Quiver.Samples.SourceGen</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Quiver\Quiver.csproj" />
