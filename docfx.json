{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/Yatagarasu/**/*.csproj",
            "src/Yatagarasu.Rag/**/*.csproj",
            "src/Yatagarasu.Hosting/**/*.csproj",
            "src/Yatagarasu.OpenTelemetry/**/*.csproj"
          ],
          "src": "."
        }
      ],
      "dest": "docs/api/_apispec",
      "includePrivateMembers": false,
      "disableGitFeatures": true,
      "disableDefaultFilter": false,
      "noRestore": true,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "EnumSortOrder": "alphabetic",
      "allowCompilationErrors": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "src": "docs/api",
        "exclude": ["_apispec/**", "_site/**"]
      },
      {
        "files": ["**/*.{md,yml}"],
        "src": "docs/api/_apispec",
        "dest": "api"
      }
    ],
    "resource": [
      {
        "files": ["images/**"],
        "src": "docs/api"
      }
    ],
    "output": "docs/api/_site",
    "globalMetadata": {
      "_appName": "Yatagarasu",
      "_appTitle": "Yatagarasu — Pure C# Graph Database",
      "_enableSearch": true,
      "pdf": false,
      "_lang": "ja"
    },
    "template": ["default", "modern"],
    "postProcessors": ["ExtractSearchIndex"],
    "keepFileLink": false,
    "disableGitFeatures": true
  }
}
