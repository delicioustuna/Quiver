<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Description>OpenTelemetry instrumentation registration for Quiver graph database.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Quiver\Quiver.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- OB-1: optional の OpenTelemetry SDK 拡張。OpenTelemetry.Api だけに依存し、
         実 exporter (Console / Prometheus / Jaeger) はアプリケーション側で選ばせる。 -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry" Version="1.15.3" />
  </ItemGroup>
</Project>
