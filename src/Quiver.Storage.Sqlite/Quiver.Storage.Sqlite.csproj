<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Quiver.Storage.Sqlite</RootNamespace>
    <Description>Optional SQLite-backed storage engine for Quiver. Durability and inspectability over raw throughput.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Quiver\Quiver.csproj" />
    <ProjectReference Include="..\Quiver.Core\Quiver.Core.csproj" />
    <ProjectReference Include="..\Quiver.Stores\Quiver.Stores.csproj" />
    <ProjectReference Include="..\Quiver.Transactions\Quiver.Transactions.csproj" />
    <ProjectReference Include="..\Quiver.Index\Quiver.Index.csproj" />
    <ProjectReference Include="..\Quiver.Operators\Quiver.Operators.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
  </ItemGroup>
</Project>
