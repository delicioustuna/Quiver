<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Quiver.Storage.Sqlite</RootNamespace>
    <Description>Optional SQLite-backed storage engine for Quiver. Durability and inspectability over raw throughput.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Quiver\Quiver.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
  </ItemGroup>
</Project>
