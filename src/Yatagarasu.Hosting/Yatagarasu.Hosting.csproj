<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>Yatagarasu.Hosting</PackageId>
    <Description>Yatagarasu グラフデータベースと Microsoft.Extensions.Hosting / DependencyInjection の統合。Options バインディング・DI 登録・ロギング連携で、汎用ホスト上のアプリに Yatagarasu を組み込めるようにする。</Description>
    <PackageTags>$(PackageTags);dependency-injection;hosting;microsoft-extensions;options</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yatagarasu\Yatagarasu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.7" />
  </ItemGroup>
</Project>
