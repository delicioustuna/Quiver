<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>Yatagarasu.OpenTelemetry</PackageId>
    <Description>Yatagarasu グラフデータベースの OpenTelemetry 計装登録。Yatagarasu が発行する traces / metrics を OpenTelemetry に接続する拡張で、実 exporter (Console / Prometheus / Jaeger 等) はアプリ側で選択する。</Description>
    <PackageTags>$(PackageTags);opentelemetry;observability;tracing;metrics;telemetry</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yatagarasu\Yatagarasu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 任意で導入できる OpenTelemetry 拡張。OpenTelemetry.Api と SDK に依存する。
         出力先（Console / Prometheus / Jaeger など）はアプリケーション側で選択する。 -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry" Version="1.15.3" />
  </ItemGroup>
</Project>
