<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- DOC-3: 公開ライブラリは XML doc 欠落 (CS1591) を抑制せず、欠落ゼロを維持する。
         Directory.Build.props は段階導入のため 1591 を全体抑制しているが、コアアセンブリだけは
         1591 を外して再有効化する (他の抑制 1573/1574/1734/0419/QUIVER001 は踏襲)。
         テスト / ベンチ / サンプルは引き続き全体抑制のまま。 -->
    <NoWarn>1573;1574;1734;0419;QUIVER001</NoWarn>
  </PropertyGroup>

  <!-- PKG-1: NuGet メインパッケージ。型付きエンティティ属性 ([Node]/[Relationship]/[Property]/
       [Indexed]) は本アセンブリに同梱 (Client/*Attribute.cs)。Source Generator (Quiver.SourceGen) は
       analyzer として同梱する。利用者は Quiver 参照だけで属性 + CRUD/トラバーサル生成が使える。 -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Quiver</PackageId>
    <Description>Pure C# の組み込み (in-process) グラフ + ベクトル + 全文検索データベースエンジン。ノード/リレーションシップをプロパティ付きで単一ファイルに永続化し、型安全な CRUD・Fluent トラバーサル・WAL クラッシュリカバリ・B+Tree インデックス・KNN ベクトル検索を提供する。属性ベースの Source Generator を同梱。NativeAOT 対応、アンマネージド依存なし。ローカル RAG バックエンドに最適。</Description>
    <PackageTags>$(PackageTags);vector-search;knn;full-text-search;rag;nativeaot;source-generator;traversal;wal;embedded-database</PackageTags>
    <!-- 同梱する analyzer を明示パックする (下の target)。 -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_QuiverAddBundledAnalyzer</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <!-- Phase 0 (ARCH-1): 旧 Quiver.Core / Codec / Wal / Storage / Stores / Index /
       Transactions / Operators / Client を本プロジェクトへ統合 (単一アセンブリ)。
       各サブ領域はフォルダ (Core/ Codec/ Wal/ Storage/ Stores/ Index/ Transactions/
       Operators/ Client/) で分離し、名前空間は従来どおり維持する。 -->
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <!-- source generator は自アセンブリに生成できない Roslyn 制約のため別プロジェクト維持。
         PrivateAssets=all: パッケージ依存にせず、DLL を analyzers/dotnet/cs に同梱する (下の target)。 -->
    <ProjectReference Include="..\Quiver.SourceGen\Quiver.SourceGen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- PKG-1: パッケージ参照だけで using なしドロップインにするための global using props を同梱する。
       build/ と buildTransitive/ の両方へ置き、直接/推移どちらの利用者にも効かせる。 -->
  <ItemGroup>
    <None Include="build\Quiver.props" Pack="true" PackagePath="build\Quiver.props;buildTransitive\Quiver.props" />
  </ItemGroup>

  <!-- PKG-1: Source Generator DLL を analyzers/dotnet/cs に同梱する。
       @(Analyzer) には自前の Quiver.SourceGen.dll に加え SDK 組み込みの NetAnalyzers も入る
       (どちらも NuGetPackageId が空)。同梱したいのは自前の generator だけなのでファイル名で限定する。 -->
  <Target Name="_QuiverAddBundledAnalyzer" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(Analyzer)" Condition="'%(Filename)' == 'Quiver.SourceGen'">
        <PackagePath>analyzers/dotnet/cs/%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
